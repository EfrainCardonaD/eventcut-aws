# App
APP_NAME=auth-service
APP_ENV=dev

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000,https://event-cut.vercel.app
TRUSTED_HOSTS=localhost,127.0.0.1,*.ngrok-free.dev
APP_FORCE_HTTPS=false

# Gateway secret (para /internal)
APP_GATEWAY_SECRET=change-me
APP_GATEWAY_VALIDATION_ENABLED=true

# JWT (HS256)
JWT_SECRET_KEY=change-me
JWT_ISSUER=microservices-app
JWT_ACCESS_EXPIRATION_MINUTES=10
JWT_REFRESH_EXPIRATION_DAYS=30

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=eventcut_auth_db
MYSQL_USER=root
MYSQL_PASSWORD=root

# SMTP
APP_MAIL_ENABLED=false
APP_MAIL_FROM=noreply@example.com
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true

# Token TTLs
VERIFICATION_TOKEN_TTL_MINUTES=60
RESET_TOKEN_TTL_MINUTES=30

# Frontend
APP_FRONTEND_BASE_URL=http://localhost:3000

# Opcional: R2 para media
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_HOST=

