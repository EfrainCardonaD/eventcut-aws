APP_NAME=events-service
APP_ENV=prod

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
TRUSTED_HOSTS=*
APP_FORCE_HTTPS=false

# Shared JWT values with auth-service
JWT_SECRET_KEY=change-me
JWT_ISSUER=microservices-app

# Gateway validation against auth-service internal endpoint
AUTH_SERVICE_BASE_URL=http://auth-service:8000
APP_GATEWAY_SECRET=change-me
AUTH_REMOTE_VALIDATION_ENABLED=true

# Amazon RDS MySQL 8.0
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=eventcut_events_db
MYSQL_USER=eventcut_admin
MYSQL_PASSWORD=change-me
MYSQL_POOL_SIZE=20
MYSQL_MAX_OVERFLOW=10

# Amazon S3 para almacenamiento de imágenes (migrado desde Cloudflare R2)
# En EC2 usa automáticamente LabInstanceProfile (sin credenciales estáticas).
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_PUBLIC_HOST=
